---
interface Props {
	title: string;
	description: string;
	path: string;
	creationDate: string;
	readingTime?: string;
	tags: string[];
}

const { title, description, path, creationDate, readingTime, tags } =
	Astro.props;
---

<article>
	<span class="path">{path}</span>

	<div class="additionnal-infos">
		<span>{creationDate}</span>
		<span>{readingTime}</span>
	</div>

	<div class="content">
		<h2># {title}</h2>
		<p>{description}</p>
	</div>

	<ul class="tags">
		{tags.map((tag) => <li>[{tag}]</li>)}
	</ul>

	<span class="vim">:wq to read</span>
</article>

<style>
	.path {
		position: absolute;
		top: -9px;
		left: 14;
		font-size: 12px;
		z-index: 10;
	}

	.path::before {
		content: " ";
		position: absolute;
		z-index: -1;
		background-color: var(--color-black);
		width: 110%;
		height: 1px;
		top: 50%;
		left: -5%;
	}

	article {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		border: 1px solid var(--color-grey);
		background-color: #282828;
		padding: 16px 14px;
		border-radius: 6px;
		gap: 32px;
	}

	article:hover {
		border-color: var(--color-orange);
		transition: border-color 0.15s ease;
		cursor: pointer;
	}

	.additionnal-infos {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 12px;
		color: var(--color-grey);
	}

	.additionnal-infos span::before {
		content: "> ";
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 12px;
		flex: 1;
	}

	.content h2 {
		font-weight: 400;
	}

	.content p {
		font-size: 12px;
	}

	.tags {
		display: flex;
		gap: 4px;
		color: var(--color-grey);
		font-size: 12px;
	}

	.vim {
		position: absolute;
		bottom: -7px;
		right: 14px;
		font-size: 12px;
		z-index: 10;
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	article:hover .vim {
		opacity: 1;
	}

	.vim::before {
		content: " ";
		position: absolute;
		z-index: -1;
		background-color: var(--color-black);
		width: 110%;
		height: 1px;
		bottom: 38%;
		right: -5%;
	}
</style>
