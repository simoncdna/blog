---
import Logo from "/public/logo_blog.svg?raw";

const navigation = [
	{ label: "Home", href: "/" },
	{ label: "Category", href: "/category" },
	{ label: "Source", href: "https://github.com/simoncdn/blog", external: true },
	{ label: "RSS", href: "/rss" },
	{ label: "About", href: "/about" },
	{ label: "Github", href: "https://github.com/simoncdn", external: true },
];

const currentPath = Astro.url.pathname;
---

<header>
	<div class="logo" set:html={Logo} />
	<nav>
		<ul>
			{
				navigation.map((nav) => (
					<li>
						<a
							href={nav.href}
							target={nav.external ? "_blank" : undefined}
							class={currentPath === nav.href ? "active" : ""}
						>
							{nav.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: end;
		width: 100%;
	}

	.logo {
		color: var(--color-white);
		width: 300px;
		height: auto;
	}

	.logo svg {
		width: 100%;
		height: 100%;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
		font-size: 16px;
	}

	a {
		text-decoration: none;
		color: var(--color-white);
		transition: color 0.15s ease;
		opacity: 1;
	}

	a::before {
		content: "> ";
	}

	a.active::before {
		content: "$ ";
	}

	a:hover:not(.active) {
		color: var(--color-grey);
		transition: color 0.15s ease;
	}

	a.active {
		color: var(--color-orange);
		cursor: default;
	}
</style>
