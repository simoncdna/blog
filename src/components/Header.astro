---
import Logo from "/public/logo_blog.svg?raw";
import { GITHUB_URL, GITHUB_BLOG_URL } from "../constants.ts";

const navigation = [
	{ label: "Home", href: "/" },
	{ label: "Categories", href: "/categories" },
	{ label: "Source", href: GITHUB_BLOG_URL, external: true },
	{ label: "RSS", href: "/rss" },
	{ label: "About", href: "/about" },
	{ label: "Github", href: GITHUB_URL, external: true },
];

const currentPath = Astro.url.pathname;
---

<header>
	<div class="logo" set:html={Logo} />
	<nav>
		<ul>
			{
				navigation.map((nav) => (
					<li>
						<a
							href={nav.href}
							target={nav.external ? "_blank" : undefined}
							class={currentPath === nav.href ? "active" : ""}
						>
							{nav.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: end;
		width: 100%;
	}

	.logo {
		color: var(--color-white);
		width: 300px;
		height: auto;
		display: flex;
		align-items: end;
	}

	.logo svg {
		width: 100%;
		height: 100%;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		row-gap: 28px;
		font-size: 16px;
	}

	ul li:nth-child(3n) {
		justify-self: end;
	}

	a::before {
		content: "> ";
	}

	a.active::before {
		content: "$ ";
	}

	a.active {
		color: var(--color-orange);
		cursor: default;
	}

	/* Desktop LG */
	@media (max-width: 1024px) {
		ul {
			gap: 24px;
			font-size: 14px;
		}
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		header {
			display: flex;
			flex-direction: column;
			align-items: start;
			width: 100%;
			gap: 64px;
		}

		.logo {
			width: 100%;
		}

		nav {
			width: 100%;
		}

		ul {
			font-size: 14px;
			width: 100%;
			margin: auto;
		}
	}
</style>
