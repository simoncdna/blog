---
import { getLang } from "../i18n/utils";

const lang = getLang(Astro.params.lang);
const pathWithoutLang = Astro.url.pathname.replace(/^\/(en|fr)/, "");
---

<div class="local-toggle-wrapper">
	<a
		href={`/en${pathWithoutLang}`}
		class:list={["local-toggle", { active: lang === "en" }]}
	>
		EN
	</a>
	<span class="local-toggle-separator">/</span>
	<a
		href={`/fr${pathWithoutLang}`}
		class:list={["local-toggle", { active: lang === "fr" }]}
	>
		FR
	</a>
</div>

<style>
	.local-toggle-wrapper {
		display: flex;
		justify-content: end;
		align-items: center;
		gap: 4px;
		font-size: 0.75rem;
	}

	.local-toggle {
		cursor: pointer;
		color: var(--color-grey);
		transition: all 0.15s ease;
		font-weight: 400;
	}

	.local-toggle:hover {
		color: var(--color-white);
		opacity: 0.4;
	}

	.local-toggle.active {
		color: var(--color-white);
		font-weight: 500;
	}

	.local-toggle-separator {
		color: var(--color-white);
	}
</style>
