---
import { getLang, getLocalizedPath } from "../../i18n/utils";

interface Props {
	id: number;
	fileName: string;
}

const { id, fileName } = Astro.props;

const lang = getLang(Astro.params.lang);
const linkURL = getLocalizedPath(lang, `/posts/${id}`);
---

<a class="link" href={linkURL}>cat ../{fileName}.md </a>

<style>
	.link {
		font-size: 0.875rem;
		color: var(--color-grey);
		transition: color 0.15s ease;
	}

	.link:hover {
		color: var(--color-orange);
		transition: color 0.15s ease;
	}

	.link::before {
		content: "> ";
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.link {
			font-size: 0.75rem;
		}
	}
</style>
