---
interface Props {
	id: number;
	fileName: string;
}

const { id, fileName } = Astro.props;
---

<a class="link" href={`/posts/${id}`}>cat ../{fileName}.md </a>

<style>
	.link {
		font-size: 12px;
		color: var(--color-grey);
		transition: color 0.15s ease;
	}

	.link:hover {
		color: var(--color-orange);
		transition: color 0.15s ease;
	}

	.link::before {
		content: "> ";
	}
</style>
