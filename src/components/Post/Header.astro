---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<header class="header">
	<a class="link" href="/">cd ..</a>
	<span>blog/posts/{title}.md</span>
</header>

<style>
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 12px;
		width: 100%;
		color: var(--color-grey);
	}
	.link {
		font-size: 12px;
		color: var(--color-grey);
		transition: color 0.15s ease;
	}

	.link:hover {
		color: var(--color-orange);
		transition: color 0.15s ease;
	}

	.link::before {
		content: "> ";
	}
</style>
