---
import { getLang, getLocalizedPath } from "../../i18n/utils";

interface Props {
	fileName: string;
}

const { fileName } = Astro.props;

const lang = getLang(Astro.params.lang);
const linkURL = getLocalizedPath(lang, "/");
---

<header class="header">
	<a class="link" href={linkURL}>cd ..</a>
	<span>blog/posts/{fileName}.md</span>
</header>

<style>
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.875rem;
		width: 100%;
		color: var(--color-grey);
	}

	.link {
		color: var(--color-grey);
		transition: color 0.15s ease;
	}

	.link:hover {
		color: var(--color-orange);
		transition: color 0.15s ease;
	}

	.link::before {
		content: "> ";
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.header {
			font-size: 0.75rem;
		}
	}
</style>
