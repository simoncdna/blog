---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<div class="wrapper">
	<Header />
	<slot />
	<Footer />
</div>

<style>
	.wrapper {
		display: flex;
		flex-direction: column;
		justify-content: start;
		align-items: start;
		width: 100%;
		min-height: 100vh;
		padding: 72px clamp(20px, 15%, 280px);
		gap: 96px;
	}

	/* Desktop XL */
	@media (max-width: 1200px) {
		.wrapper {
			padding: 72px clamp(24px, 15%, 100px);
		}
	}

	/* Desktop LG */
	@media (max-width: 1024px) {
		.wrapper {
			padding: 24px clamp(12px, 5%, 32px);
		}
	}
</style>
