---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<div class="wrapper">
	<Header />
	<slot />
	<Footer />
</div>

<style>
	.wrapper {
		display: flex;
		flex-direction: column;
		justify-content: start;
		align-items: start;
		width: 100%;
		min-height: 100vh;
		padding: 72px 280px;
		gap: 64px;
	}
</style>
