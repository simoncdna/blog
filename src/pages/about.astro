---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LINKEDIN_URL, GITHUB_URL, EMAIL } from "../constants.ts";
import TypeWriter from "../components/TypeWriter.astro";

const baseInfos = [
	{ label: "name", value: "Simon Cardona" },
	{ label: "role", value: "Frontend Developer" },
	{ label: "tech", value: "React / Next.js / Vue / Rust / Neovim" },
	{ label: "location", value: "Toulouse, France" },
	{
		label: "description",
		value:
			"Terminal enthusiast. As my co-workers say, I'm a curious frontend dev — I love exploring things beyond my job tasks.",
	},
] as const;

const projects = [
	{ name: "Lazytasks", url: `${GITHUB_URL}/lazytasks` },
	{ name: "next-plugin-qrcode", url: `${GITHUB_URL}/next-plugin-qrcode` },
] as const;

const socials = [
	{
		label: "contact",
		value: "simon.cdna-pro@proton.me",
		url: `mailto:${EMAIL}`,
	},
	{ label: "github", value: "github/simoncdn", url: GITHUB_URL },
	{ label: "linkedin", value: "in/simoncdn", url: LINKEDIN_URL },
] as const;
---

<BaseLayout>
	<div class="content-wrapper">
		<TypeWriter text="whoami" revealTarget="#content" />

		<div id="content" class="content fade hidden">
			<ul class="info-list">
				{
					baseInfos.map((info) => (
						<li class="info">
							<span>{info.label}</span>
							<span>{info.value}</span>
						</li>
					))
				}
			</ul>

			<ul class="info-list">
				<div class="info">
					<span>projects</span>
					<ul class="projects-list">
						{
							projects.map((project) => (
								<li class="project">
									<a href={project.url} target="_blank">
										{project.name}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				{
					socials.map((social) => (
						<li class="info">
							<span>{social.label}</span>
							<a href={social.url} target="_blank">
								{social.value}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</BaseLayout>

<style>
	.content-wrapper,
	.content {
		display: flex;
		flex-direction: column;
		justify-content: start;
		align-items: start;
		height: 100%;
		flex: 1;
		gap: 32px;
	}

	.info-list {
		display: grid;
		grid-template-columns: 120px 1fr;
		max-width: 70%;
	}

	.info {
		display: contents;
	}

	.info a {
		width: fit-content;
	}

	.projects-list {
		display: flex;
		gap: 8px;
	}

	.project {
		display: flex;
	}

	.project:not(:first-child)::before {
		content: "•";
		margin-right: 8px;
	}

	/* Desktop LG */
	@media (max-width: 1024px) {
		.info {
			font-size: 14px;
		}
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.info-list {
			max-width: 100%;
		}
		.info {
			font-size: 14px;
		}
		.projects-list {
			flex-wrap: wrap;
			gap: 4px;
		}
		.project:not(:first-child)::before {
			content: "•";
			margin-right: 4px;
		}
	}
</style>
