---
import { getAllPosts } from "../../lib/posts";
import PostLayout from "../../layouts/PostLayout.astro";
import { getFormattedDate } from "../../lib/getFormattedDate";
import { getReadingTime } from "../../lib/getReadingTime";
import Header from "../../components/Post/Header.astro";
import Footer from "../../components/Post/Footer.astro";
import Frontmatter from "../../components/Post/Frontmatter.astro";
import { render } from "astro:content";
import FooterItem from "../../components/Post/FooterItem.astro";

export async function getStaticPaths() {
	const posts = await getAllPosts();

	return posts.map((post, index) => ({
		params: { id: post.data.id },
		props: {
			post,
			prevPost: posts[index + 1] ?? null,
			nextPost: posts[index - 1] ?? null,
		},
	}));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<PostLayout>
	<div class="content-wrapper">
		<Header fileName={post.id} />
		<Frontmatter
			date={getFormattedDate(post.data.creationDate)}
			readingTime={getReadingTime(post.body)}
			tags={post.data.tags}
		/>
		<Content />

		<span class="end-of-file">EOF</span>

		<Footer>
			{
				prevPost ? (
					<FooterItem id={prevPost.data.id} fileName={prevPost.id} />
				) : (
					<span />
				)
			}
			{nextPost && <FooterItem id={nextPost.data.id} fileName={nextPost.id} />}
		</Footer>
	</div>
</PostLayout>

<style>
	.content-wrapper {
		display: flex;
		flex-direction: column;
		justify-content: start;
		align-items: start;
		width: 100%;
		min-height: 100vh;
		padding: 72px 280px;
		gap: 32px;
	}

	.end-of-file::before {
		content: "> ";
	}

	/* Desktop XL */
	@media (max-width: 1200px) {
		.content-wrapper {
			padding: 72px clamp(24px, 15%, 100px);
		}
	}

	/* Desktop LG */
	@media (max-width: 1024px) {
		.content-wrapper {
			padding: 24px clamp(12px, 5%, 32px);
			font-size: 14px;
		}
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.content-wrapper {
			font-size: 12px;
		}
	}
</style>
