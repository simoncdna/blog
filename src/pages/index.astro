---
import ArticlePreview from "../components/ArticlePreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import posts from "../../fakeDate.json";
---

<BaseLayout>
	<div class="content">
		<div class="input">$ find posts --search</div>

		<ul class="articles">
			{
				posts.map((post) => (
					<li>
						<ArticlePreview
							title={post.title}
							description={post.description}
							path={post.path}
							creationDate={post.creationDate}
							readingTime={post.readingTime}
							tags={post.tags}
						/>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.content {
		display: flex;
		flex-direction: column;
		gap: 24px;
		flex: 1;
		width: 100%;
	}

	.input {
		display: flex;
		border: 1px solid var(--color-grey);
		border-radius: 6px;
		color: var(--color-grey);
		width: calc(50% - 10px);
		font-size: 14px;
		padding: 4px 8px;
		align-self: self-end;
	}

	.articles {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}
</style>
