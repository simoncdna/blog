---
import PostPreview from "../../components/PostPreview.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getPostPath } from "../../lib/getPostPath";
import { getFormattedDate } from "../../lib/getFormattedDate";

import { getAllPosts } from "../../lib/posts";
import { getReadingTime } from "../../lib/getReadingTime";

import SearchBar from "../../components/SearchBar.astro";
import { getLocale, useTranslations } from "../../i18n/utils";
import { locales } from "../../i18n/config";
import TypeWriter from "../../components/TypeWriter.astro";

export function getStaticPaths() {
	const params = locales.map((locale) => {
		return { params: { locale } };
	});
	return params;
}

const locale = getLocale(Astro.params.locale);
const t = useTranslations(locale);

const posts = await getAllPosts({ locale });
---

<BaseLayout title={t("nav.home")}>
	<div class="content-wrapper">
		<TypeWriter
			id="typewriter"
			text="ls -la ~/blog/posts"
			revealTarget="#content"
		/>

		<div id="content" class="content fade hidden">
			<ul class="posts">
				{
					posts.length > 1 ? (
						posts.map(({ data, body }) => (
							<li>
								<PostPreview
									id={data.id}
									title={data.title}
									description={data.description}
									path={getPostPath(data.id)}
									creationDate={getFormattedDate(data.creationDate)}
									readingTime={getReadingTime(body)}
									tags={data.tags}
								/>
							</li>
						))
					) : (
						<span>{t("home.posts.empty")}</span>
					)
				}
			</ul>
		</div>
	</div>
</BaseLayout>

<style>
	.content,
	.content-wrapper {
		display: flex;
		flex-direction: column;
		justify-content: start;
		align-items: start;
		width: 100%;
		gap: 32px;
		flex: 1;
	}

	.posts {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.posts {
			grid-template-columns: repeat(1, 1fr);
		}
	}
</style>
