---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getFormattedDate } from "../../../lib/getFormattedDate";
import { getAllTags, getPostsByTag } from "../../../lib/posts";
import TypeWriter from "../../../components/TypeWriter.astro";

import { ANIMATION_TYPING_SPEED } from "../../../constants";
import { getLocale, getLocalizedPath, getPostSlug } from "../../../i18n/utils";
import { locales } from "../../../i18n/config";

export async function getStaticPaths() {
	const params = await Promise.all(
		locales.map(async (locale) => {
			const tags = await getAllTags({ locale });

			return tags.map((tag) => ({
				params: { locale, tag: tag.name },
			}));
		}),
	);

	return params.flat();
}

const { tag: currentTag } = Astro.params;
const locale = getLocale(Astro.params.locale);

const tags = await getAllTags({ locale });
const posts = await getPostsByTag(currentTag, { locale });

const MARGIN = 400;
const firstText = `cd ${currentTag}/`;
const secondDelay = firstText.length * ANIMATION_TYPING_SPEED + MARGIN;
---

<BaseLayout>
	<div class="content-wrapper">
		<span class="command">$ ls -la ~/blog/categories</span>

		<main class="content">
			<ul class="tags-list">
				{
					tags.map((tag) => (
						<li>
							<a
								class:list={[
									"terminal-row",
									{ "is-active": tag.name === currentTag },
								]}
								href={getLocalizedPath(locale, `/categories/${tag.name}`)}
							>
								<span>drwxr-xr-x</span>
								<span>{tag.name}/</span>
								<span>({tag.count})</span>
							</a>
						</li>
					))
				}
			</ul>

			<div class="commands">
				<TypeWriter text={`cd ${currentTag}/`} revealTarget="#typewriter-2" />
				<TypeWriter
					id="typewriter-2"
					class="hidden"
					delay={secondDelay}
					text="ls -la"
					revealTarget="#posts-list"
				/>
			</div>

			<ul id="posts-list" class="fade hidden">
				{
					posts.map((post) => (
						<li>
							<a
								class="terminal-row"
								href={getLocalizedPath(locale, `/posts/${post.data.id}`)}
							>
								<span>-rw-r--r--</span>
								<span class="file-date">
									{getFormattedDate(post.data.creationDate)}
								</span>
								<span>{getPostSlug(post.id, locale)}.md</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
	</div>
</BaseLayout>

<style>
	.content-wrapper {
		display: flex;
		flex-direction: column;
		gap: 32px;
		flex: 1;
		width: 100%;
	}

	.command {
		color: var(--color-grey);
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: fit-content;
	}

	.commands {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.terminal-row {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, 150px);
		gap: 16px;
	}

	.terminal-row.is-active {
		color: var(--color-orange);
	}

	.terminal-row:not(.is-active):hover::before {
		content: "> ";
		color: var(--color-grey);
		position: absolute;
		left: -18px;
	}

	.terminal-row.is-active::before {
		content: "> ";
		position: absolute;
		left: -18px;
	}

	:global(#typewriter-2.hidden) {
		display: none;
	}

	/* Desktop LG */
	@media (max-width: 1024px) {
		.content,
		.command {
			font-size: 0.875rem;
		}
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.terminal-row {
			grid-template-columns: auto 1fr auto;
		}
	}
</style>
