---
import TypeWriter from "../../components/TypeWriter.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllTags } from "../../lib/posts";
import { getLocale, getLocalizedPath, useTranslations } from "../../i18n/utils";
import { locales } from "../../i18n/config";

export function getStaticPaths() {
	const params = locales.map((locale) => {
		return { params: { locale } };
	});
	return params;
}

const locale = getLocale(Astro.params.locale);
const t = useTranslations(locale);

const tags = await getAllTags({ locale });
---

<BaseLayout title={t("nav.categories")}>
	<div class="content-wrapper">
		<TypeWriter
			id="typewriter"
			text="ls -la ~/blog/categories"
			revealTarget="#content"
		/>

		<div id="content" class="content fade hidden">
			<ul>
				{
					tags.map((tag) => (
						<li>
							<a
								class="category"
								href={getLocalizedPath(locale, `/categories/${tag.name}`)}
							>
								<span>drwxr-xr-x</span>
								<span>{tag.name}/</span>
								<span>({tag.count})</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</BaseLayout>

<style>
	.content-wrapper {
		display: flex;
		flex-direction: column;
		gap: 32px;
		flex: 1;
		width: 100%;
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: fit-content;
	}

	.command-wrapper {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.category {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, 150px);
		cursor: pointer;
		gap: 16px;
	}

	.category:hover::before {
		content: "> ";
		color: var(--color-grey);
		position: absolute;
		left: -18px;
	}

	/* Desktop LG */
	@media (max-width: 1024px) {
		.content {
			font-size: 0.875rem;
		}
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.category {
			grid-template-columns: auto 1fr auto;
		}
	}
</style>
