---
import ArticlePreview from "../../components/ArticlePreview.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getArticlePath } from "../../lib/getArticlePath";
import { getFormattedDate } from "../../lib/getFormattedDate";

import { getAllPosts } from "../../lib/posts";
import { getReadingTime } from "../../lib/getReadingTime";

import SearchBar from "../../components/SearchBar.astro";
import { getLang, useTranslations } from "../../i18n/utils";
import { locales } from "../../i18n/config";

export function getStaticPaths() {
	const params = locales.map((local) => {
		return { params: { lang: local } };
	});
	return params;
}

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);

const posts = await getAllPosts({ lang });
---

<BaseLayout>
	<div class="content">
		<SearchBar />

		<ul class="articles">
			{
				posts.length > 1 ? (
					posts.map(({ data, body }) => (
						<li>
							<ArticlePreview
								id={data.id}
								title={data.title}
								description={data.description}
								path={getArticlePath(data.id)}
								creationDate={getFormattedDate(data.creationDate)}
								readingTime={getReadingTime(body)}
								tags={data.tags}
							/>
						</li>
					))
				) : (
					<span>{t("home.posts.empty")}</span>
				)
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.content {
		display: flex;
		flex-direction: column;
		gap: 24px;
		flex: 1;
		width: 100%;
	}

	.articles {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.articles {
			grid-template-columns: repeat(1, 1fr);
		}
	}
</style>
