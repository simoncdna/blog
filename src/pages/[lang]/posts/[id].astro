---
import { getAllPosts } from "../../../lib/posts";
import PostLayout from "../../../layouts/PostLayout.astro";
import { getFormattedDate } from "../../../lib/getFormattedDate";
import { getReadingTime } from "../../../lib/getReadingTime";
import Header from "../../../components/Post/Header.astro";
import Footer from "../../../components/Post/Footer.astro";
import Frontmatter from "../../../components/Post/Frontmatter.astro";
import { render } from "astro:content";
import FooterItem from "../../../components/Post/FooterItem.astro";
import { locales } from "../../../i18n/config";
import { getPostSlug } from "../../../i18n/utils";

export async function getStaticPaths() {
	const params = await Promise.all(
		locales.map(async (lang) => {
			const posts = await getAllPosts({ lang });

			return posts.map((post, index) => ({
				params: { lang, id: post.data.id },
				props: {
					post,
					prevPost: posts[index + 1] ?? null,
					nextPost: posts[index - 1] ?? null,
				},
			}));
		}),
	);

	return params.flat();
}

const { post, prevPost, nextPost } = Astro.props;
const { lang } = Astro.params;

const { Content } = await render(post);
---

<PostLayout>
	<div class="content-wrapper">
		<Header fileName={getPostSlug(post.id, lang)} />
		<Frontmatter
			date={getFormattedDate(post.data.creationDate)}
			readingTime={getReadingTime(post.body)}
			tags={post.data.tags}
		/>
		<Content />

		<span class="end-of-file">EOF</span>

		<Footer>
			{
				prevPost ? (
					<FooterItem
						id={prevPost.data.id}
						fileName={getPostSlug(prevPost.id, lang)}
					/>
				) : (
					<span />
				)
			}
			{
				nextPost && (
					<FooterItem
						id={nextPost.data.id}
						fileName={getPostSlug(nextPost.id, lang)}
					/>
				)
			}
		</Footer>
	</div>
</PostLayout>

<style>
	.content-wrapper {
		display: flex;
		flex-direction: column;
		justify-content: start;
		align-items: start;
		width: 100%;
		min-height: 100vh;
		padding: 72px 280px;
		gap: 32px;
	}

	.end-of-file::before {
		content: "> ";
	}

	/* Desktop XL */
	@media (max-width: 1200px) {
		.content-wrapper {
			padding: 72px clamp(24px, 15%, 100px);
		}
	}

	/* Desktop LG */
	@media (max-width: 1024px) {
		.content-wrapper {
			padding: 24px clamp(12px, 5%, 32px);
			font-size: 0.875rem;
		}
	}

	/* Desktop MD */
	@media (max-width: 768px) {
		.content-wrapper {
			font-size: 0.75rem;
		}
	}
</style>
